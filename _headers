# Cloudflare Pages / Netlify : ces fichiers ne doivent jamais être servis depuis un cache HTTP périmé
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
/version.json
  Cache-Control: no-store
/manifest.json
  Cache-Control: no-cache
/partners.json
  Cache-Control: no-cache
/reviews.json
  Cache-Control: no-cache
/deals.json
  Cache-Control: no-cache
/rdv.json
  Cache-Control: no-cache
/icons/*
  Cache-Control: public, max-age=31536000, immutable
