{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ausbildung occupation catalogue",
  "type": "object",
  "required": [
    "schema_version",
    "catalogue_status",
    "occupations",
    "sources",
    "general"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "catalogue_status": {
      "enum": [
        "development_draft",
        "verified_for_publication"
      ]
    },
    "occupations": {
      "type": "array",
      "minItems": 14,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title_de",
          "title_fr",
          "category",
          "training_type",
          "duration_months",
          "interests",
          "skills",
          "environments",
          "experience_domains",
          "language_guidance",
          "title_en",
          "title_ar",
          "sector",
          "fiche"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "title_de": {
            "type": "string",
            "minLength": 3
          },
          "title_fr": {
            "type": "string",
            "minLength": 3
          },
          "category": {
            "type": "string"
          },
          "training_type": {
            "enum": [
              "dual",
              "regulated_school_based",
              "school_based",
              "other"
            ]
          },
          "duration_months": {
            "type": "integer",
            "minimum": 12,
            "maximum": 60
          },
          "interests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "environments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "experience_domains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "language_guidance": {
            "type": "object",
            "required": [
              "level",
              "status"
            ],
            "properties": {
              "level": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "type": "string"
              }
            }
          },
          "title_en": {
            "type": "string",
            "minLength": 3
          },
          "title_ar": {
            "type": "string",
            "minLength": 3
          },
          "sector": {
            "enum": [
              "health",
              "it",
              "tech",
              "logistics",
              "hospitality",
              "retail"
            ]
          },
          "fiche": {
            "type": "object",
            "required": [
              "summary",
              "source"
            ],
            "description": "Toute donnée chiffrée ou réglementaire porte un id de source ; une donnée absente vaut null et s'affiche « Non confirmé »."
          }
        },
        "additionalProperties": true
      }
    },
    "verified_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "title",
          "url",
          "checked"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "checked": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    },
    "general": {
      "type": "object",
      "description": "Informations communes (candidature depuis la Tunisie) ; chaque entrée = texte FR/EN/AR + id de source."
    }
  },
  "additionalProperties": false
}